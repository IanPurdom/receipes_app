#!/bin/bash -e

# If running the rails server then create or migrate existing database.
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  # Create the database and run migrations synchronously (fast DDL only).
  # This must happen before Puma starts, since Puma runs the SolidQueue
  # supervisor in-process (SOLID_QUEUE_IN_PUMA) and would otherwise query
  # tables (e.g. solid_queue_recurring_tasks) before they exist.
  ./bin/rails db:create db:migrate

  # Seeding downloads and imports hundreds of recipes, which can take
  # several minutes on the first deploy. Only seed when the database is
  # actually empty, and run it in the background so Puma can start
  # immediately and pass health checks (e.g. Render's /up probe).
  if [ "$(./bin/rails runner 'puts Receipe.count' 2>/dev/null)" = "0" ]; then
    ./bin/rails db:seed &
  fi
fi

exec "${@}"
