<% content_for(:title) { "What would you like to cook today?" } %>

<main class="container">
  <h1>What would you like to cook today?</h1>

  <%= form_with url: receipes_path, method: :get, local: true, class: "search-form",
         data: {
           controller: "ingredient-autocomplete",
           ingredient_autocomplete_url_value: ingredient_suggestions_path,
           action: "change->ingredient-autocomplete#submitOnChange"
         } do |f| %>
    <div class="field ingredient-autocomplete">
      <label for="ingredient-search">Ingredients</label>
      <div class="ingredient-input">
        <%= tag.input type: "text",
              id: "ingredient-search",
              placeholder: "Type an ingredient, e.g.: Tomato",
              autocomplete: "off",
              role: "combobox",
              aria: {
                autocomplete: "list",
                controls: "ingredient-suggestions",
                expanded: "false"
              },
              data: {
                ingredient_autocomplete_target: "input",
                action: "input->ingredient-autocomplete#search keydown->ingredient-autocomplete#navigate"
              } %>
        <ul id="ingredient-suggestions"
            class="ingredient-suggestions"
            role="listbox"
            aria-label="Ingredient suggestions"
            data-ingredient-autocomplete-target="suggestions"
            hidden></ul>
      </div>
      <ul class="ingredient-tags" aria-label="Selected ingredients" data-ingredient-autocomplete-target="tags">
        <% @ingredient_names.each do |name| %>
          <li class="tag">
            <span><%= name %></span>
            <% if (note = @ingredient_notes[name.downcase]) %><span class="tag-note">(<%= note %>)</span><% end %>
            <%= hidden_field_tag "ingredients[]", name, id: nil %>
            <button type="button"
                    class="tag-remove"
                    aria-label="Remove <%= name %>"
                    data-action="click->ingredient-autocomplete#removeTag">&times;</button>
          </li>
        <% end %>
      </ul>
      <p class="visually-hidden"
         aria-live="polite"
         data-ingredient-autocomplete-target="status"></p>
    </div>

    <fieldset class="field">
      <legend>Match mode</legend>

      <label class="radio-label">
        <%= f.radio_button :match, "all", checked: @match == "all" %>
        Contains <strong>all</strong> the ingredients
      </label>

      <label class="radio-label">
        <%= f.radio_button :match, "any", checked: @match == "any" %>
        Contains <strong>at least one</strong> of the ingredients
      </label>
    </fieldset>

    <div class="field">
      <%= f.label :max_total_time, "Max total time (prep + cook, in minutes)" %>
      <%= f.number_field :max_total_time, value: @max_total_time, min: 1, placeholder: "e.g.: 30" %>
    </div>

    <div class="field">
      <%= f.label :min_rating, "Min rating (0-5)" %>
      <%= f.number_field :min_rating, value: @min_rating, min: 0, max: 5, step: 0.1, placeholder: "e.g.: 4" %>
    </div>

    <div class="field">
      <%= f.label :per_page, "Receipes per page" %>
      <%= f.select :per_page, ReceipesController::PER_PAGE_OPTIONS, selected: @per_page %>
    </div>
  <% end %>

  <section class="results">
    <% if @ingredient_names.empty? && @max_total_time.nil? && @min_rating.nil? %>
      <p class="hint">Enter one or more ingredients, a max total time and/or a min rating to start a search.</p>
    <% elsif @receipes.empty? %>
      <p class="hint">
        No receipe matches these criteria<% if @ingredient_names.any? %> (ingredients: <strong><%= @ingredient_names.join(", ") %></strong>)<% end %><% if @max_total_time %> (max total time: <strong><%= @max_total_time %> min</strong>)<% end %><% if @min_rating %> (min rating: <strong><%= @min_rating %>/5</strong>)<% end %>.
      </p>
    <% else %>
      <p class="result-count">
        <%= pluralize(@total_count, "receipe") %> found<% if @total_pages > 1 %> (page <%= @page %> of <%= @total_pages %>)<% end %>
      </p>

      <ul class="receipe-list">
        <% @receipes.each do |receipe| %>
          <li class="receipe-card">
            <%= image_tag receipe_image_url(receipe),
                  alt: receipe.title,
                  class: "receipe-image",
                  loading: "lazy",
                  onerror: "this.onerror=null;this.src='#{image_path(ReceipesHelper::DEFAULT_IMAGE)}'" %>

            <h2><%= receipe.title %></h2>

            <p class="meta">
              <% if receipe.cuisine.present? %><span><%= receipe.cuisine %></span><% end %>
              <% if receipe.category.present? %><span><%= receipe.category %></span><% end %>
              <% if receipe.author.present? %><span>by <%= receipe.author %></span><% end %>
            </p>

            <p class="meta">
              <% if receipe.prep_time.present? %><span>Prep: <%= receipe.prep_time %> min</span><% end %>
              <% if receipe.cook_time.present? %><span>Cook: <%= receipe.cook_time %> min</span><% end %>
              <% if total_time(receipe) %><span>Total: <%= total_time(receipe) %> min</span><% end %>
              <% if receipe.ratings.present? %><span>Rating: <%= receipe.ratings %>/5</span><% end %>
            </p>

            <ul class="ingredients">
              <% receipe.lists.each do |list| %>
                <li>
                  <span class="quantity"><%= format_quantity(list.measure, list.ingredient.measure_type) %></span>
                  <%= ingredient_display_name(list.measure, list.ingredient.measure_type, list.ingredient.name) %><% if list.direction.present? %>, <%= list.direction.strip %><% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>

      <% if @total_pages > 1 %>
        <nav class="pagination" aria-label="Pagination">
          <% if @page > 1 %>
            <%= link_to "← Previous", receipes_path(request.query_parameters.merge(page: @page - 1)), rel: "prev" %>
          <% end %>
          <span>Page <%= @page %> / <%= @total_pages %></span>
          <% if @page < @total_pages %>
            <%= link_to "Next →", receipes_path(request.query_parameters.merge(page: @page + 1)), rel: "next" %>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </section>
</main>
