<% content_for(:title) { "What would you like to cook today?" } %>

<main class="container">
  <h1>What would you like to cook today?</h1>

  <%= form_with url: receipes_path, method: :get, local: true, class: "search-form",
         data: { controller: "auto-submit", action: "change->auto-submit#submit" } do |f| %>
    <section class="search-main">
    <%= render "ingredient_field",
          label: "What would please you?",
          field_id: "ingredient-search",
          name: "ingredients[]",
          placeholder: "Type an ingredient, e.g.: Tomato",
          names: @ingredient_names,
          notes: @ingredient_notes %>

    <fieldset class="field match-mode">
      <legend class="visually-hidden">Match mode</legend>

      <div class="segmented">
        <label class="segment">
          <%= f.radio_button :match, "all", checked: @match == "all" %>
          <span>Contains <strong>all</strong> the ingredients</span>
        </label>

        <label class="segment">
          <%= f.radio_button :match, "any", checked: @match == "any" %>
          <span>Contains <strong>at least one</strong> of the ingredients</span>
        </label>
      </div>
    </fieldset>

    <%= render "ingredient_field",
          label: "Anything you hate?",
          field_id: "excluded-search",
          name: "excluded[]",
          placeholder: "Receipes containing it are hidden, e.g.: Cilantro",
          names: @excluded_names,
          notes: @excluded_notes,
          extra_class: "excluded" %>
    </section>

    <section class="search-options">
    <div class="field">
      <%= f.label :max_total_time, "How much time you got?" %>
      <%= f.select :max_total_time,
            (ReceipesController::MAX_TOTAL_TIME_OPTIONS | [@max_total_time].compact).sort.map { |minutes| ["Less than #{minutes} min", minutes] },
            { include_blank: "Any", selected: @max_total_time } %>
    </div>

    <div class="field">
      <%= f.label :min_rating, "How good you want it?" %>
      <%= f.select :min_rating,
            (ReceipesController::MIN_RATING_OPTIONS | [@min_rating&.to_f].compact).map { |rating| rating == rating.to_i ? rating.to_i : rating }.uniq.sort.reverse.map { |rating| ["More than #{rating} rating", rating] },
            { include_blank: "Any", selected: @min_rating && (@min_rating.to_f == @min_rating.to_i ? @min_rating.to_i : @min_rating.to_f) } %>
    </div>

    <div class="field">
      <%= f.label :sort, "Sort by" %>
      <%= f.select :sort, ReceipesController::SORT_OPTIONS.map { |key, (label, _)| [label, key] }, selected: @sort %>
    </div>

    <div class="field">
      <%= f.label :per_page, "Receipes per page" %>
      <%= f.select :per_page, ReceipesController::PER_PAGE_OPTIONS, selected: @per_page %>
    </div>
    </section>
  <% end %>

  <section class="results">
    <% if @ingredient_names.empty? && @excluded_names.empty? && @max_total_time.nil? && @min_rating.nil? %>
      <p class="hint">Enter one or more ingredients, ingredients to avoid, a max total time and/or a min rating to start a search.</p>

      <% if @suggestions.any? %>
        <h2 class="suggestions-title">Need inspiration? Top-rated picks</h2>
        <ul class="receipe-list">
          <% @suggestions.each do |receipe| %>
            <%= render "receipe", receipe: receipe %>
          <% end %>
        </ul>
      <% end %>
    <% elsif @receipes.empty? %>
      <p class="hint">
        No receipe matches these criteria<% if @ingredient_names.any? %> (ingredients: <strong><%= @ingredient_names.join(", ") %></strong>)<% end %><% if @excluded_names.any? %> (without: <strong><%= @excluded_names.join(", ") %></strong>)<% end %><% if @max_total_time %> (max total time: <strong><%= @max_total_time %> min</strong>)<% end %><% if @min_rating %> (min rating: <strong><%= @min_rating %>/5</strong>)<% end %>.
      </p>
    <% else %>
      <p class="result-count">
        <%= pluralize(@total_count, "receipe") %> found<% if @total_pages > 1 %> (page <%= @page %> of <%= @total_pages %>)<% end %>
      </p>

      <ul class="receipe-list">
        <% @receipes.each do |receipe| %>
          <%= render "receipe", receipe: receipe %>
        <% end %>
      </ul>

      <% if @total_pages > 1 %>
        <nav class="pagination" aria-label="Pagination">
          <% if @page > 1 %>
            <%= link_to "← Previous", receipes_path(request.query_parameters.merge(page: @page - 1)), rel: "prev" %>
          <% end %>
          <span>Page <%= @page %> / <%= @total_pages %></span>
          <% if @page < @total_pages %>
            <%= link_to "Next →", receipes_path(request.query_parameters.merge(page: @page + 1)), rel: "next" %>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </section>
</main>
