<% content_for(:title) { "Search receipes" } %>

<main class="container">
  <h1>Search receipes by ingredients</h1>

  <%= form_with url: receipes_path, method: :get, local: true, class: "search-form" do |f| %>
    <div class="field">
      <%= f.label :ingredients, "Ingredients (comma-separated)" %>
      <%= f.text_field :ingredients,
            value: @ingredient_names.join(", "),
            placeholder: "e.g.: Tomato, Garlic, Basil" %>
    </div>

    <fieldset class="field">
      <legend>Match mode</legend>

      <label class="radio-label">
        <%= f.radio_button :match, "all", checked: @match == "all" %>
        Contains <strong>all</strong> the ingredients
      </label>

      <label class="radio-label">
        <%= f.radio_button :match, "any", checked: @match == "any" %>
        Contains <strong>at least one</strong> of the ingredients
      </label>
    </fieldset>

    <div class="field">
      <%= f.label :max_total_time, "Max total time (prep + cook, in minutes)" %>
      <%= f.number_field :max_total_time, value: @max_total_time, min: 1, placeholder: "e.g.: 30" %>
    </div>

    <%= f.submit "Search" %>
  <% end %>

  <section class="results">
    <% if @ingredient_names.empty? && @max_total_time.nil? %>
      <p class="hint">Enter one or more ingredients and/or a max total time to start a search.</p>
    <% elsif @receipes.empty? %>
      <p class="hint">
        No receipe matches these criteria<% if @ingredient_names.any? %> (ingredients: <strong><%= @ingredient_names.join(", ") %></strong>)<% end %><% if @max_total_time %> (max total time: <strong><%= @max_total_time %> min</strong>)<% end %>.
      </p>
    <% else %>
      <p class="result-count">
        <%= pluralize(@receipes.size, "receipe") %> found
      </p>

      <ul class="receipe-list">
        <% @receipes.each do |receipe| %>
          <li class="receipe-card">
            <%= image_tag receipe_image_url(receipe),
                  alt: receipe.title,
                  class: "receipe-image",
                  loading: "lazy",
                  onerror: "this.onerror=null;this.src='#{image_path(ReceipesHelper::DEFAULT_IMAGE)}'" %>

            <h2><%= receipe.title %></h2>

            <p class="meta">
              <% if receipe.cuisine.present? %><span><%= receipe.cuisine %></span><% end %>
              <% if receipe.category.present? %><span><%= receipe.category %></span><% end %>
              <% if receipe.author.present? %><span>by <%= receipe.author %></span><% end %>
            </p>

            <p class="meta">
              <% if receipe.prep_time.present? %><span>Prep: <%= receipe.prep_time %> min</span><% end %>
              <% if receipe.cook_time.present? %><span>Cook: <%= receipe.cook_time %> min</span><% end %>
              <% if total_time(receipe) %><span>Total: <%= total_time(receipe) %> min</span><% end %>
              <% if receipe.ratings.present? %><span>Rating: <%= receipe.ratings %>/5</span><% end %>
            </p>

            <ul class="ingredients">
              <% receipe.lists.each do |list| %>
                <li>
                  <span class="quantity"><%= format_quantity(list.measure, list.ingredient.measure_type) %></span>
                  <%= list.ingredient.name %><% if list.direction.present? %>, <%= list.direction.strip %><% end %>
                </li>
              <% end %>
            </ul>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>
</main>
